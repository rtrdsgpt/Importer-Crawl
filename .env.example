HF_TOKEN=hf_your_token_here
OPENAI_API_KEY=sk-your_openai_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GEMINI_API_KEY=sk-gem-your_gemini_key_here
GROQ_API_KEY=sk-gro-your_groq_key_here
# Any of the above accepts a comma-separated list of keys, e.g.:
# GROQ_API_KEY=sk-gro-key_one,sk-gro-key_two
# Phase 4 ranking then round-robins to the next key when one hits its
# daily quota mid-run, instead of stopping the whole run early.